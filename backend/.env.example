# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Dialect can be 'postgres' or 'sqlite' (sqlite is useful for zero-config local testing)
DB_DIALECT=sqlite
# For PostgreSQL / Neon / Render:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/gatemining?sslmode=require
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gate_mining_db
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT Secrets
JWT_ACCESS_SECRET=gate_mining_access_super_secret_key_2027_production_grade
JWT_REFRESH_SECRET=gate_mining_refresh_super_secret_key_2027_production_grade
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Content Configuration
EXAM_YEAR=2027
CONTENT_VERSION=2027-v1
